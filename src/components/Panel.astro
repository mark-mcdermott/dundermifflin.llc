---
interface Props {
  title?: string
  class?: string
  /** Optional id so docs anchors can target a panel. */
  id?: string
}

const { title, class: className, id } = Astro.props
---

<section class:list={['panel', className]} id={id}>
  {title && <h2 class="panel-title">{title}</h2>}
  <div class="panel-body">
    <slot />
  </div>
</section>
